# Copy to `.env` to override defaults locally. Every variable is optional and
# prefixed with FACELAB_; see facelab/config.py for the full list.

FACELAB_ENV=dev

# Storage mode: "dev" keeps the roster, photos, frames, datasets, caches, and
# results on disk in FACELAB_DATA_DIR. Any other env value (e.g. "prod") switches
# to ephemeral storage instead: data goes to FACELAB_EPHEMERAL_DIR and is wiped
# on startup. Uncomment to force persistence/ephemerality regardless of env.
# FACELAB_EPHEMERAL_DATA=false
# FACELAB_EPHEMERAL_DIR=/tmp/facelab

# Where model packs live (one directory per pack, containing *.onnx files).
FACELAB_MODELS_DIR=models
# Where the roster, frames, datasets, cache, and saved results live (dev only).
FACELAB_DATA_DIR=.data

# Legacy InsightFace pack selection, kept for the fetch script and old callers.
FACELAB_DEFAULT_MODEL=buffalo_l
# Load only what detection + recognition needs to keep memory and startup low.
FACELAB_ALLOWED_MODULES=detection,recognition

# Default detector / recognizer pair from the registry (facelab/config.py).
FACELAB_DEFAULT_DETECTOR=insightface:scrfd_10g_bnkps
FACELAB_DEFAULT_RECOGNIZER=insightface:w600k_r50

# Detector input resolution: enrollment can stay small; scans often want larger.
FACELAB_FACE_DET_SIZE=640
FACELAB_FACE_SCAN_DET_SIZE=1280
FACELAB_FACE_SCAN_MAX_FRAMES=12

# Matching. accept >= review; a face below accept but above review is flagged
# for manual inspection, and the top1-top2 margin gate rejects ambiguous picks.
FACELAB_ACCEPT_THRESHOLD=0.42
FACELAB_REVIEW_THRESHOLD=0.34
FACELAB_MIN_MARGIN=0.04
# Legacy single-threshold default (kept for the old API shape).
FACELAB_FACE_SIMILARITY_THRESHOLD=0.42

# Defaults for scans and benchmark sweeps.
#   assignment: hungarian | greedy | margin
#   tiling:     none | sahi_upper_band | sahi_full
#   fusion:     k_of_n_voting | max_with_margin_gate | quality_weighted_embedding_cluster
FACELAB_ASSIGNMENT_MODE=hungarian
FACELAB_TEMPLATE_STRATEGY=top_k_mean
FACELAB_TEMPLATE_TOP_K=2
FACELAB_TILING_MODE=none
FACELAB_MULTI_FRAME_FUSION=k_of_n_voting
FACELAB_FUSION_K=2
FACELAB_MIN_FACE_QUALITY=0.0

# Optional UniFace predictors (require the uniface package).
FACELAB_QUALITY_PREDICTOR=uniface:ediffiqa_s
FACELAB_HEAD_POSE_PREDICTOR=uniface:headpose_6d

# Benchmark grid defaults.
FACELAB_BENCHMARK_DET_SIZES=640,1024,1280
FACELAB_BENCHMARK_MAX_ROWS=32
FACELAB_BENCHMARK_MAX_FRAMES=60

# Reference-photo limits.
FACELAB_MAX_PHOTOS_PER_UPLOAD=8
FACELAB_MAX_PHOTOS_PER_PERSON=12

# Container/start.sh model fetch: "1" = default pack, "all" = every pack + YuNet
# + UniFace weights (large download), "0" = skip fetching.
FACELAB_FETCH_MODELS=1

# Set to 1 to make start.sh fail fast when model fetching fails (default warns
# and starts anyway).
FACELAB_FETCH_STRICT=0

# How many saved results, scan folders, and datasets to keep on disk.
FACELAB_RESULTS_TO_KEEP=50
FACELAB_SCANS_TO_KEEP=50
FACELAB_DATASETS_TO_KEEP=25

# Comma-separated allowed origins for the API (the parent Attendyrc app).
FACELAB_CORS_ORIGINS=http://127.0.0.1:8010,http://localhost:8010

# When set, every mutating endpoint requires Authorization: Bearer <token> or
# X-API-Token: <token>.
# FACELAB_API_TOKEN=

# ONNX Runtime providers, comma separated. Empty = auto (CUDA -> CoreML -> CPU).
# FACELAB_ONNX_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
